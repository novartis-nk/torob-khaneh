{
  "name": "torob-khaneh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "python3 -m backend.dev",
    "build": "vite build",
    "start": "python3 -m backend.app",
    "test": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "seed": "node scripts/seed.mjs",
    "demo": "node scripts/record-demo.mjs",
    "ingest": "python3 -m backend.ingest",
    "format": "prettier --write src scripts tests/browser *.mjs *.json",
    "check:format": "prettier --check src scripts tests/browser *.mjs *.json && python3 -m py_compile backend/*.py tests/python/*.py",
    "safar:refresh": "node scripts/refresh-safar.mjs",
    "demo:safar": "node scripts/record-safar-demo.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "vite": "^7.3.0"
  }
}
